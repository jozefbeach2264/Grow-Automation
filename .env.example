# AC Infinity credentials -- copy this file to .env and fill these in
AC_INFINITY_EMAIL=your-email@example.com
AC_INFINITY_PASSWORD=your-password

# Cached auth token (auto-updated by poller on login -- leave blank initially)
AC_INFINITY_TOKEN=

# Poll interval in seconds
# POLL_INTERVAL is the fallback when AI is disabled
POLL_INTERVAL=30
# Adaptive intervals when AI is enabled:
POLL_INTERVAL_STABLE=900
POLL_INTERVAL_ACTIVE=60

# AI advisor
AI_ENABLED=true
ADVISORY_MODE=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Schedule-driven hardware ------------------------------------------------
# Photoperiod: hours on per 24h cycle, hours off, when on-period begins,
# and the speed (0-10) the light should run at when on.
# 24/0 = lights stay on continuously. LIGHT_CYCLE_START is ignored in 24h mode.
LIGHT_HOURS_ON=24
LIGHT_HOURS_OFF=0
LIGHT_CYCLE_START=06:00
LIGHT_INTENSITY=10
# Sunrise / sunset fade -- minutes ramping 0 <-> LIGHT_INTENSITY at each edge of
# the on-period. Stepped (X6 takes int 0-10); 15 min = ~1 step per 90s. Both 0
# disables the fade (instant on/off). Has no effect in 24/0 mode.
LIGHT_SUNRISE_MIN=0
LIGHT_SUNSET_MIN=0

# Role mappings -- device:port for schedule-controlled outputs.
# If hardware ever moves, update these (no code change needed).
ROLE_LIGHT=4 x 4:1
ROLE_OSC_FANS=4 x 4:3,4 x 4:4

# Oscillating fans run constant; 10 = full speed. Set to 0 to disable enforcement.
OSC_FAN_SPEED=10

# CO2 enrichment valve location -- "<device>:<port>". The reservoir co2_gate
# blocks turning this ON when gate is HOLD or REDUCE. Turning OFF is always allowed.
# Leave blank to disable the CO2 gate enforcement.
#
# The 120V solenoid plugs into a single Aux outlet (already labeled "CO2 Valve").
# That outlet is dual-purpose by physics: ON = mains energized = solenoid open =
# enrichment flowing; OFF = mains killed = solenoid closed = emergency cutoff.
# Same action, two framings -- one outlet controls both.
# The UIS line on the Aux strip carries the CO2 SENSOR signal, not valve control.
CO2_VALVE=Auxiliary Outputs:2

# CO2 emergency dump -- because the single CO2 outlet can't independently
# "fail safe" while also modulating dosing, we use the exhaust fan as the
# panic lever. When CO2 exceeds CO2_EMERGENCY_PPM, deterministic code forces
# the valve OFF and ramps the exhaust to max. Hysteresis: stays active until
# CO2 drops below CO2_DUMP_CLEAR_PPM to prevent flapping.
# Set CO2_EMERGENCY_PPM=0 to disable the dump entirely.
CO2_EMERGENCY_PPM=3000
CO2_DUMP_CLEAR_PPM=1800
ROLE_EXHAUST=4 x 4:2

# High-temperature exhaust guardrail -- deterministic, climate-only. When the
# watched canopy sensor crosses AIR_TEMP_EMERGENCY_F, code forces ROLE_EXHAUST
# to max (it NEVER touches chemicals or the CO2 valve). Hysteresis: stays active
# until the sensor drops below AIR_TEMP_CLEAR_F. Actuates only in LIVE; in
# ADVISORY it just alerts. Set AIR_TEMP_EMERGENCY_F=0 to disable.
# HIGH_TEMP_SENSOR is the snapshot sensor key to watch (default the in-canopy
# external probe on "4 x 4"). AIR_TEMP_MAX below is only a soft target band.
AIR_TEMP_EMERGENCY_F=95
AIR_TEMP_CLEAR_F=88
HIGH_TEMP_SENSOR=temp_f_tent

# Away-mode triage executor -- deterministic, code-driven. When AWAY_MODE=true it
# reads the diagnostics stressor list each cycle, alerts on the worst stressor,
# and dispatches the worst ACTIONABLE stressor's top allowed playbook. CLIMATE
# ONLY actuates live: increase_exhaust_one_step steps ROLE_EXHAUST +AWAY_EXHAUST_STEP
# (capped at AWAY_EXHAUST_MAX). reduce_light is advisory (the schedule enforcer pins
# light), disable_co2 + chemical playbooks are dry-run/logged. Actuates only when
# ADVISORY_MODE=false; in ADVISORY it logs "would dispatch". Default off.
AWAY_MODE=false
AWAY_EXHAUST_STEP=1
AWAY_EXHAUST_MAX=10
AWAY_LIGHT_FLOOR=1

# CO2 pulse band -- deterministic on/off modulation around the per-week target.
# Valve ON when co2_ppm < (target - band), OFF when > (target + band),
# hold previous state in between (hysteresis). Default band = 250 ppm
# (= 500 ppm total deadband). Smaller = tighter control + more cycling.
CO2_PULSE_BAND_PPM=250

# Safety guardrails
DOSE_LOCKOUT_MINUTES=15
PH_LOCKOUT_MINUTES=20
MAX_DOSER_SPEED=2
MAX_DOSE_ML_CYCLE=50
OUTCOME_WAIT_CYCLES=2

# Read-after-write verification -- after each hardware write, poll readback until the
# port reports the expected state. A doser/pH STOP that can't be confirmed is retried
# and, if still unverified, FREEZES dosing (pump may still be running). Set false to
# skip (test rigs). The SIM token always skips regardless.
VERIFY_WRITES=true

# Chemical kill switch -- freezes doser + pH ports ONLY (lights, fans, exhaust,
# CO2 keep running). Coarse manual override; the poller also persists an auto-trip
# freeze in profiles/.safety_state.json on a safety failure. Stops always allowed.
# Clear the persisted freeze via safety_state.clear_dosing_disable() after inspection.
DOSING_DISABLED=false

# Reservoir-burst shutdown -- WATER/CHEMICAL ONLY: stops dosers + closes the CO2
# valve. Lights and ventilation are NEVER cut, burst or not. Disabled by default.
# Trips off the BOOLEAN leak sensor (water_leak), never the manual WATER_LEVEL_TREND.
RES_BURST_ENABLED=false
RES_BURST_DEBOUNCE=2             # consecutive WET leak reads before tripping (1 = first read)
LEAK_SENSOR=Auxiliary Outputs   # device whose sensorType=20 is the boolean LEAK detector (-> water_leak)

# Evac pump -- outlet that pumps water OUT while the leak sensor is wet, and turns
# OFF when it reads dry (so it never runs dry). Tracks the leak sensor directly;
# independent of RES_BURST_ENABLED. Blank = no pump / no action. Set to <device>:<port>
# once wired (e.g. "Auxiliary Outputs:3"). Uses the debounced wet state (RES_BURST_DEBOUNCE).
EVAC_PUMP=

# Nutrient port ratio -- ports 1 and 2, must sum to 100.
# Hard limits enforced by safety gate: neither side can exceed 55 or fall below 45.
# Increase NUTRIENT_RATIO_2 for more PK (bloom push), increase NUTRIENT_RATIO_1 for more nitrogen.
NUTRIENT_RATIO_1=50
NUTRIENT_RATIO_2=50

# Reservoir change mode -- set true during res fills to uncap nutrient ports 1+2 to speed 10.
# pH ports (3+4) always stay at their per-port cap regardless of this flag.
RES_CHANGE_MODE=false

# Active reservoir volume in gallons -- anchors all dose-size math (mL delivered
# -> ppm / pH shift). A 0.5 mL pH dose hits very differently in 20 gal vs 60 gal.
# Default 60; set to your actual filled volume. Non-positive values fall back to 60.
RESERVOIR_VOLUME_GAL=60

# Target ranges fed directly into the AI prompt — tune these per strain/stage
#
# pH defaults are now stage-driven from the grow calendar:
#   veg   -> 5.5 - 6.0   (acidic for N uptake)
#   bloom -> 5.8 - 6.2   (slightly higher for P/K availability)
#   bloom wk8 (flush) -> 6.0 - 6.5
# Uncomment PH_MIN / PH_MAX below to override globally, or use
# PH_MIN_VEG_WK<N> / PH_MAX_BLOOM_WK<N> for per-week overrides.
# PH_MIN=5.5
# PH_MAX=6.5
TDS_MIN=800
TDS_MAX=1600

# PPM scale: 500 (Hanna/Eutech meters) or 700 (Truncheon/Bluelab meters)
PPM_SCALE=500

# Extend week: pins the schedule at this week while GROW_WEEK keeps counting.
# FloraFlex recommends: extend veg at wk4, bloom at wk6.
# Uncomment to activate. Clear or raise the number to allow advancing past it.
# EXTEND_VEG_WEEK=4
# EXTEND_BLOOM_WEEK=6

# PPM targets per week -- FloraFlex defaults are baked in, only add a line to override.
# Format: PPM_<STAGE>_WK<N>=<ppm value>
# Example overrides:
# PPM_VEG_WK2=550
# PPM_BLOOM_WK3=1050
EC_TOLERANCE=0.1

# CO2 targets per week (ppm) -- Dr. Bruce Bugbee (Utah State) defaults baked in.
# Only add a line here to override a specific week.
# Format: CO2_<STAGE>_WK<N>=<ppm>
# Example: CO2_BLOOM_WK3=1400
CO2_TOLERANCE=100
WATER_TEMP_MIN=65
WATER_TEMP_MAX=72
AIR_TEMP_MIN=70
AIR_TEMP_MAX=85
HUMIDITY_MIN=50
HUMIDITY_MAX=70
VPD_MIN=0.8
VPD_MAX=1.5
CO2_MIN=800
CO2_MAX=1500

# Water level source. Priority: FLOAT > manual TREND > analog sensor.
#
# WATER_LEVEL_FLOAT=true: the reservoir sensor is a boolean magnetic float,
# repositioned daily to the expected drawdown line. dry(0) = water fell below
# today's line -> FALLING; wet(1) = still at/above it -> STATIC. (A single float
# can't see RISING -- use the manual TREND below for problem states.) Set this
# false when you swap in an ultrasonic/analog depth sensor.
WATER_LEVEL_FLOAT=true
#
# Manual override fallback -- used only when FLOAT is off or the float isn't
# reading. FALLING / STATIC / RISING, or blank.
WATER_LEVEL_TREND=FALLING

# Strain profile
STRAIN_NAME=
RUN_ID=run_1

# Grow calendar -- when GROW_START_DATE is set, GROW_WEEK and GROW_STAGE are
# auto-computed from elapsed days and the manual values below are ignored.
# Clear GROW_START_DATE (leave blank) to disable auto-mode.
GROW_START_DATE=                # date veg began (YYYY-MM-DD)
VEG_DAYS=28                     # planned veg duration (4 weeks default)
FLOWER_DAYS=63                  # planned flower duration (9 weeks default)

# Manual fallback -- only used when GROW_START_DATE is empty
GROW_WEEK=1
GROW_STAGE=veg
