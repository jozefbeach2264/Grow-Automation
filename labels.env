# Port labels for AC Infinity devices
# Format: PORT_<DEVICE_NAME_SLUG>_<NUMBER>=Your Label
# Slugs are the device name: uppercase, spaces replaced with underscores

# Hide air temp/humidity/VPD sensors from display and AI snapshot for these devices.
# Water temp is unaffected. Set to true for devices where air readings are irrelevant.
HIDE_AIR_AUXILIARY_OUTPUTS=true
# Hydroponics Control built-in = Outside reference (stable, far from tent). External probe suppressed.
# 4x4 EXTERNAL probe (type0) = Tent = in-canopy INSIDE TEMP; IT heat-soaks to ~93F under the X6
# (verified 2026-06-05 via body-heat probe test). Built-in (type4) = cooler secondary ~80F, suppressed.
HIDE_AIR_BUILTIN_4_X_4=true
HIDE_AIR_EXT_HYDROPONICS_CONTROL=true

# Display order for devices (lower number = printed first)
DISPLAY_ORDER_4_X_4=1
DISPLAY_ORDER_HYDROPONICS_CONTROL=2
DISPLAY_ORDER_AUXILIARY_OUTPUTS=3

# --- Auxiliary Outputs (ADA4) ---
PORT_AUXILIARY_OUTPUTS_1=Water Detection
PORT_AUXILIARY_OUTPUTS_2=CO2 Valve
PORT_AUXILIARY_OUTPUTS_3=
PORT_AUXILIARY_OUTPUTS_4=

# Air sensor labels -- override "Air" and "Air(2)" display names per device
# Format: AIR_LABEL_<DEVICE_SLUG>=Label   AIR2_LABEL_<DEVICE_SLUG>=Label
AIR_LABEL_4_X_4=Tent_Intake
AIR2_LABEL_4_X_4=Tent
AIR_LABEL_HYDROPONICS_CONTROL=Outside

# --- 4 x 4 (CTR89Q) ---
PORT_4_X_4_1=Growcraft X6
PORT_4_X_4_2=Exhaust Fan
PORT_4_X_4_3=Oscillating Fan 1
PORT_4_X_4_4=Oscillating Fan 2
PORT_4_X_4_5=
PORT_4_X_4_6=
PORT_4_X_4_7=
PORT_4_X_4_8=

# --- Hydroponics Control (CTR89Q) ---
PORT_HYDROPONICS_CONTROL_1=Floraflex V1
PORT_HYDROPONICS_CONTROL_2=Floraflex V2
PORT_HYDROPONICS_CONTROL_3=PH UP
PORT_HYDROPONICS_CONTROL_4=PH DOWN
PORT_HYDROPONICS_CONTROL_5=
PORT_HYDROPONICS_CONTROL_6=
PORT_HYDROPONICS_CONTROL_7=
PORT_HYDROPONICS_CONTROL_8=

# Doser ports - display shows dose rate % instead of fan speed
# Format: DOSER_PORTS_<DEVICE_NAME_SLUG>=comma separated port numbers
DOSER_PORTS_HYDROPONICS_CONTROL=1,2,3,4

# pH ports - safety gate applies longer lockout to these
# Format: PH_PORTS_<DEVICE_NAME_SLUG>=comma separated port numbers
PH_PORTS_HYDROPONICS_CONTROL=3,4

# Per-port speed caps (0-10). Overrides MAX_DOSER_SPEED for that port only.
# Format: MAX_SPEED_<DEVICE_NAME_SLUG>_<PORT>=<0-10>
MAX_SPEED_HYDROPONICS_CONTROL_1=2
MAX_SPEED_HYDROPONICS_CONTROL_2=2
MAX_SPEED_HYDROPONICS_CONTROL_3=1
MAX_SPEED_HYDROPONICS_CONTROL_4=1
